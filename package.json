{
  "name": "qiju-board-game-arcade",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env --import=tsx src/server/server.ts",
    "dev": "node --env-file-if-exists=.env --import=tsx --watch src/server/server.ts",
    "migrate": "node --env-file-if-exists=.env --import=tsx scripts/migrate.ts",
    "test": "node --env-file-if-exists=.env --import=tsx --test test/*.ts",
    "test:postgres": "node --env-file-if-exists=.env --import=tsx --test test/postgres-room-store.test.ts test/server.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.ts\" --max-warnings 0",
    "format": "prettier --write lib/*.ts src/**/*.ts scripts/*.ts test/**/*.ts playwright.config.ts public/index.html public/style.css docs/*.md README.md package.json tsconfig.json eslint.config.mjs",
    "format:check": "prettier --check lib/*.ts src/**/*.ts scripts/*.ts test/**/*.ts playwright.config.ts public/index.html public/style.css docs/*.md README.md package.json tsconfig.json eslint.config.mjs",
    "test:e2e": "npm run build && playwright test",
    "build": "tsx scripts/build.ts"
  },
  "dependencies": {
    "@kobalab/majiang-ai": "1.2.0",
    "@kobalab/majiang-core": "1.4.1",
    "chess.js": "^1.4.0",
    "pg": "^8.23.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.6.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
